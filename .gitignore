```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.py.class
*.py.obj
*.py.out
*.py.dll
*.py.so
*.py.a
*.py.o

# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/

# Coverage
.coverage
coverage/
htmlcov/

# Build artifacts
dist/
build/
target/
*.class
*.exe
*.dll
*.so
*.a
*.obj
*.out
```