# Copy this file to backend/.env on EC2 and set the real values there.
# Never commit backend/.env or real credentials.
ENVIRONMENT=production
PORT=8000
AWS_REGION=us-east-1

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# API auth + vault encryption (must match backend/shared/config.py fields).
# API_KEY: required to enforce X-API-Key auth on all data/compute endpoints.
# JWT_SECRET: required in production for broker/AI-key vault encryption
#   (server refuses to encrypt with a default key when this is unset).
API_KEY=
JWT_SECRET=

ALLOWED_ORIGINS=

# AI Chat (Gemini) - Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Production Infrastructure (Optional)
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://user:password@localhost:5432/stockoracle
