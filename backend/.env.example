# Copy this file to backend/.env on EC2 and set the real values there.
# Never commit backend/.env or real credentials.
ENV=production
PORT=8000
AWS_REGION=us-east-1

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
SECRET_KEY=

ALLOWED_ORIGINS=

# AI Chat (Gemini) - Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
